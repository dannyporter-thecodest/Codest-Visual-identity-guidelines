{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Codest answer article",
  "type": "object",
  "description": "Shape of content.json. Rules: content-creation/articles/rules/. Text fields accept inline Markdown links [text](url) and **bold**.",
  "required": [
    "slug",
    "category",
    "topic_area",
    "title",
    "lead",
    "tldr",
    "published",
    "updated",
    "review_by",
    "seo",
    "sections",
    "key_insights",
    "information_gain",
    "related_case",
    "cta",
    "sources",
    "meta",
    "report"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+){2,5}$"
    },
    "category": {
      "enum": [
        "buyer-questions",
        "ai-in-industry"
      ]
    },
    "topic_area": {
      "enum": [
        "capacity",
        "vendor-choice",
        "delivery-handover",
        "regulated-finance",
        "modernisation",
        "ai-in-industry"
      ]
    },
    "industry": {
      "enum": [
        "fintech",
        "payments",
        "digital-banking",
        "marketplaces",
        "internet",
        "saas",
        "all"
      ]
    },
    "title": {
      "type": "string",
      "description": "One buyer question, 7 to 14 words, max 70 characters, ends with ?"
    },
    "lead": {
      "type": "string",
      "description": "Direct answer, 40 to 70 words, 2 or 3 sentences"
    },
    "tldr": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "author": {
      "$ref": "#/$defs/person",
      "description": "Optional. Default: topics.json site.default_author"
    },
    "reviewer": {
      "$ref": "#/$defs/person",
      "description": "Optional. Only if a person actually reviewed the article"
    },
    "published": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "review_by": {
      "type": "string",
      "format": "date"
    },
    "seo": {
      "type": "object",
      "required": [
        "primary_query",
        "secondary_queries",
        "query_source",
        "meta_title",
        "meta_description"
      ],
      "properties": {
        "primary_query": {
          "type": "string"
        },
        "secondary_queries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "query_source": {
          "enum": [
            "sales-call",
            "search-console",
            "keyword-tool",
            "topic-list"
          ]
        },
        "meta_title": {
          "type": "string",
          "minLength": 50,
          "maxLength": 60
        },
        "meta_description": {
          "type": "string",
          "minLength": 120,
          "maxLength": 155
        },
        "canonical": {
          "type": "string",
          "description": "Optional. Default: topics.json site.article_base + slug + /"
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "answer",
          "based_on"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "description": "A question ending with ?"
          },
          "answer": {
            "type": "string",
            "description": "20 to 45 words; the first sentence answers the heading"
          },
          "bullets": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "bold": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "table": {
            "type": "object",
            "required": [
              "caption",
              "columns",
              "rows"
            ],
            "properties": {
              "caption": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "paragraphs": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "subsections": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "heading": {
                  "type": "string"
                },
                "paragraphs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "takeaway": {
            "type": "string",
            "description": "What this means for you: 10 to 30 words"
          },
          "based_on": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(general|case:[a-z0-9-]+|codest:https://\\S+|src:.+)$"
            },
            "description": "At least 3 sections with src:, at least 1 with case: or codest:, at most 2 with general only"
          }
        }
      }
    },
    "limits_section": {
      "type": [
        "integer",
        "null"
      ],
      "description": "ai-in-industry: index of the section on when AI is the wrong choice"
    },
    "key_insights": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "related_questions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "related_case": {
      "type": "object",
      "required": [
        "title",
        "category",
        "href"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      }
    },
    "cta": {
      "type": "object",
      "required": [
        "title",
        "text",
        "label",
        "href"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "description": "At least 2 different publishers",
      "items": {
        "type": "object",
        "required": [
          "id",
          "publisher",
          "title",
          "url",
          "date",
          "accessed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "enum": [
              "data",
              "regulation",
              "law",
              "research",
              "documentation"
            ],
            "description": "law: a law or standard in force, exempt from the 3-year recency warning"
          }
        }
      }
    },
    "brief": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "audience_group",
        "buying_role",
        "funnel_stage"
      ],
      "properties": {
        "audience_group": {
          "enum": [
            "1",
            "2",
            "3",
            "all"
          ]
        },
        "buying_role": {
          "type": "string"
        },
        "funnel_stage": {
          "enum": [
            "signal",
            "qualified conversation"
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "claim_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^CLM-\\d{3}$"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Facts Cody could not verify"
        },
        "self_check": {
          "type": "object",
          "description": "14 items from rules/08-checks.md, each answered yes, no or n/a with a note"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "information_gain": {
      "type": "object",
      "required": [
        "type",
        "description",
        "built_from"
      ],
      "properties": {
        "type": {
          "enum": [
            "table",
            "checklist",
            "framework",
            "comparison"
          ]
        },
        "description": {
          "type": "string",
          "description": "15 to 60 words: what the article adds that no single source has"
        },
        "built_from": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "description": "src:<id>, case:<slug> or codest:<url>, as used in based_on"
          }
        }
      }
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        }
      }
    }
  }
}